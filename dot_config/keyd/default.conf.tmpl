# vim: ft=conf

[ids]
*

[main]
capslock = overload(capslock_layer, esc)
rightmeta = layer(rightwin)
{{ if eq .chezmoi.hostname "asahi" -}}
fn = leftcontrol
leftalt = leftmeta
leftmeta = leftalt
rightmeta = rightalt
rightalt = rightcontrol
{{- end }}

[capslock_layer]
h = left
j = down
k = up
l = right

\ = backspace
backspace = delete
space = space

left = home
right = end
up = pageup
down = pagedown

{{ if eq .chezmoi.hostname "cd-tower" }}
[capslock_layer+shift]
\ = delete

[rightwin]
# media
[ = previoussong
] = nextsong
0 = mute
- = volumedown
= = volumeup
backspace = playpause

# navigation
h = home
j = pagedown
k = pageup
l = end
{{ end }}
