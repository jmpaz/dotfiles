# vim: ft=conf

config-file = theme
term = xterm-256color

config-file = fonts
font-size = 16

window-padding-balance = false
window-padding-x = 14,0
window-padding-y = 4,0

window-decoration = false
resize-overlay = never

cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true

mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
mouse-shift-capture = true
copy-on-select = clipboard

shell-integration = fish

# keybinds
keybind = clear
keybind = ctrl+comma=open_config
keybind = ctrl+shift+comma=reload_config

keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+end=scroll_to_bottom

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection

keybind = ctrl+8=decrease_font_size:1
keybind = ctrl+9=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

keybind = ctrl+shift+page_down=jump_to_prompt:1
keybind = ctrl+shift+page_up=jump_to_prompt:-1
