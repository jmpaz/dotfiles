#!/usr/bin/env sh

ctrl + ralt - r : skhd --restart-service
ralt - return : open -na "/Users/josh/Applications/Ghostty.app" ~

## Navigation
# space nav
ralt - 1 : yabai -m space --focus "$(yabai -m query --displays --display | jq '.spaces[0]')"
ralt - 2 : yabai -m space --focus "$(yabai -m query --displays --display | jq '.spaces[1]')"
ralt - 3 : yabai -m space --focus "$(yabai -m query --displays --display | jq '.spaces[2]')"
ralt - 4 : yabai -m space --focus "$(yabai -m query --displays --display | jq '.spaces[3]')"

# window nav
ralt - h : yabai -m window --focus west  || yabai -m display --focus west
ralt - j : yabai -m window --focus south || yabai -m display --focus south
ralt - k : yabai -m window --focus north || yabai -m display --focus north
ralt - l : yabai -m window --focus east  || yabai -m display --focus east

# toggle float
ralt - space : yabai -m window --toggle float

# zoom to fullscreen
ralt - f : yabai -m window --toggle zoom-fullscreen

# zoom to parent node
ralt - z : yabai -m window --toggle zoom-parent

## Window Movement (shift + ralt - ...)
# Moving windows in spaces: shift + ralt
shift + ralt - h : yabai -m window --warp west || $(yabai -m window --display west && yabai -m display --focus west && yabai -m window --warp last) || yabai -m window --move rel:-10:0
shift + ralt - j : yabai -m window --warp south || $(yabai -m window --display south && yabai -m display --focus south) || yabai -m window --move rel:0:10
shift + ralt - k : yabai -m window --warp north || $(yabai -m window --display north && yabai -m display --focus north) || yabai -m window --move rel:0:-10
shift + ralt - l : yabai -m window --warp east || $(yabai -m window --display east && yabai -m display --focus east && yabai -m window --warp first) || yabai -m window --move rel:10:0

# Toggle split orientation of the selected windows node: shift + ralt - s
shift + ralt - s : yabai -m window --toggle split

# Moving windows between spaces: shift + ralt - {1, 2, 3, 4, p, n } (Assumes 4 Spaces Max per Display)
shift + ralt - 1 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[1] ]] \
                  && yabai -m window --space $SPACES[1]

shift + ralt - 2 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[2] ]] \
                  && yabai -m window --space $SPACES[2]

shift + ralt - 3 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[3] ]] \
                  && yabai -m window --space $SPACES[3]

shift + ralt - 4 : SPACES=($(yabai -m query --displays --display | jq '.spaces[]')) && [[ -n $SPACES[4] ]] \
                  && yabai -m window --space $SPACES[4]

shift + ralt - p : yabai -m window --space prev && yabai -m space --focus prev
shift + ralt - n : yabai -m window --space next && yabai -m space --focus next

# Mirror Space on X and Y Axis: shift + ralt - {x, y}
shift + ralt - x : yabai -m space --mirror x-axis
shift + ralt - y : yabai -m space --mirror y-axis

