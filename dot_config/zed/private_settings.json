//  https://zed.dev/docs/configuring-zed
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "calls": {
    "mute_on_join": true,
    "share_on_join": false
  },

  "outline_panel": {
    "default_width": 420,
    "indent_size": 18
  },

  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_code_navigation": true
  },

  "gutter": {
    // "folds": false,
    "code_actions": false
  },
  "inlay_hints": {
    "enabled": true
  },

  "active_pane_magnification": 1.2,
  "current_line_highlight": "gutter",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "use_autoclose": true,
  "always_treat_brackets_as_autoclosed": true,

  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
    "use_multiline_find": true
  },
  "relative_line_numbers": true,
  "cursor_blink": false,

  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine"
  },
  "buffer_font_family": "Input Mono",
  "ui_font_family": "iMWritingQuat Nerd Font",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "experimental.theme_overrides": {
    "syntax": {
      "property": {}
    }
  },

  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml",
    "**/secrets.txt"
  ],

  "terminal": {
    // "font_size": 17,
    "button": false,
    "font_weight": 500,
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/fish",
        "args": ["-c", "set -x SKIP_TMUX 1; direnv reload; exec fish"]
      }
    }
  },

  "collaboration_panel": {
    "button": false
  },

  "features": {
    "edit_prediction_provider": "zed"
  },
  "language_models": {
    "openai": {
      "version": "1",
      "api_url": "https://api.consciousdata.dev/v1",
      "available_models": [
        {
          "name": "claude-3.7-sonnet",
          "display_name": "Claude 3.7 Sonnet",
          "max_tokens": 200000
        },
        {
          "name": "claude-3.6-sonnet",
          "display_name": "Claude 3.6 Sonnet",
          "max_tokens": 200000
        },
        {
          "name": "claude-3.5-sonnet",
          "display_name": "Claude 3.5 Sonnet",
          "max_tokens": 200000
        },
        {
          "name": "claude-3.5-haiku",
          "display_name": "Claude 3.5 Haiku",
          "max_tokens": 200000
        },
        {
          "name": "claude-3-haiku",
          "display_name": "Claude 3 Haiku",
          "max_tokens": 200000
        },
        {
          "name": "claude-opus",
          "display_name": "Claude 3 Opus",
          "max_tokens": 200000
        },
        {
          "name": "deepseek-r1-fp8",
          "display_name": "Deepseek R1",
          "max_tokens": 128000
        }
      ]
    }
  },
  "assistant": {
    "button": false,
    "default_model": {
      "provider": "openai",
      "model": "claude-3.6-sonnet"
    },
    "version": "2",
    "provider": null
  },
  "slash_commands": {
    "docs": {
      "enabled": true
    }
  },

  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500
    }
  },

  "jupyter": {
    "enabled": true,
    "kernel_selections": {}
  },
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true
            //"source.fixAll.ruff": false
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "workspace"
          // "typeCheckingMode": "strict"
        },
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          // "lineLength": 80,
          "lint": {
            // isort
            // "extendSelect": ["I"]
          }
        }
      }
    }
  },

  "middle_click_paste": false
}
