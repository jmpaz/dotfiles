# vim: ft=tmux

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'laktak/extrakto'
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'pschmitt/tmux-ssh-split'
set -g @override_copy_command "fish -c 'copy'"

set -g @plugin 'jabirali/tmux-normalmode'

{{ if eq .chezmoi.os "darwin" }}
set-option -g default-shell '/usr/local/bin/fish'
set-option -g default-command ''
{{ end }}

set -g @resurrect-dir '~/.local/share/tmux/resurrect'
set -g @resurrect-save 'S'
set -g @resurrect-restore 'R'
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

source-file ~/.config/tmux/theme.conf

set-option -g default-terminal    'tmux-256color'
set -as terminal-overrides ",*:RGB"

set -s focus-events on
setw -g aggressive-resize on
set -g update-environment "DISPLAY SSH_ASKPASS SSH_AUTH_SOCK SSH_AGENT_PID SSH_CONNECTION SSH_TTY WINDOWID XAUTHORITY WAYLAND_DISPLAY"

set-option -g status-keys vi
set-option -g mode-keys vi
set-option -g mouse on
set-option -g xterm-keys on
set -g prompt-cursor-style bar

set -g @vim_navigator_mapping_left 'M-h'
set -g @vim_navigator_mapping_right 'M-l'
set -g @vim_navigator_mapping_up 'M-k'
set -g @vim_navigator_mapping_down 'M-j'
set -g @vim_navigator_mapping_prev 'M-\'

# prefix
unbind C-b
set-option -g prefix M-a
set-option -g prefix2 M-q
bind M-a send-prefix
bind C-l run-shell "colorweave scheme apply --from-cache light >/dev/null 2>&1 && tmux source-file ~/.config/tmux/theme.conf && tmux display-message 'theme: light'"
bind C-d run-shell "colorweave scheme apply --from-cache dark >/dev/null 2>&1 && tmux source-file ~/.config/tmux/theme.conf && tmux display-message 'theme: dark'"

# pane navigation
bind -n M-h if -F '#{window_zoomed_flag}' 'resize-pane -Z; select-pane -L; resize-pane -Z' 'select-pane -L'
bind -n M-j if -F '#{window_zoomed_flag}' 'resize-pane -Z; select-pane -D; resize-pane -Z' 'select-pane -D'
bind -n M-k if -F '#{window_zoomed_flag}' 'resize-pane -Z; select-pane -U; resize-pane -Z' 'select-pane -U'
bind -n M-l if -F '#{window_zoomed_flag}' 'resize-pane -Z; select-pane -R; resize-pane -Z' 'select-pane -R'

bind h run-shell "bash ~/.config/tmux/scripts/popup.sh"

# scrollback navigation
bind -n M-Up if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X -N 3 scroll-up
bind -n M-Down if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X -N 3 scroll-down
bind -n M-u if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X page-up
bind -n M-d if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X page-down
bind -n M-[ if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X previous-paragraph \; send-keys -X cursor-up \; send-keys -X start-of-line
bind -n M-] if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X next-paragraph \; send-keys -X cursor-down \; send-keys -X start-of-line
bind -n M-S-[ if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X history-top \; send-keys -X start-of-line
bind -n M-S-] if-shell -F '!#{pane_in_mode}' 'copy-mode -e' \; send-keys -X history-bottom \; send-keys -X cancel


# split panes
set -g @ssh-split-v-key '-'
set -g @ssh-split-h-key "\\"
unbind-key M-_
unbind-key M-|
bind - split-window -v -c "#{pane_current_path}"
bind _ split-window -v -b -c "#{pane_current_path}"
bind '\' split-window -h -c "#{pane_current_path}"
bind '|' split-window -h -b -c "#{pane_current_path}"

set-option -g @ssh-split-keep-cwd "true"
set-option -g @ssh-split-keep-remote-cwd "false"
set-option -g @ssh-split-no-env "true"
set-option -g @ssh-split-verbose "false"


# resize panes
bind -n M-H resize-pane -L 5
bind -n M-J resize-pane -D 5
bind -n M-K resize-pane -U 5
bind -n M-L resize-pane -R 5

# swap panes
bind -n C-M-h if -F '#{pane_at_left}' '' 'swap-pane -s "{left-of}"'
bind -n C-M-j if -F '#{pane_at_bottom}' '' 'swap-pane -s "{down-of}"'
bind -n C-M-k if -F '#{pane_at_top}' '' 'swap-pane -s "{up-of}"'
bind -n C-M-l if -F '#{pane_at_right}' '' 'swap-pane -s "{right-of}"'


bind M-o display-popup -E "tms"
bind M-Tab display-popup -E "tms switch"
bind -n M-Tab display-popup -E "tms windows"
bind r run-shell 'tms refresh'
unbind M-r
bind M-r display-menu -T "Rename" \
    "Pane    | #{pane_title}" p "command-prompt -l -I '#{pane_title}' -p 'Rename pane to:' \"select-pane -t #{pane_id} -T '%%'\"" \
    "Window  | #{window_index}:#{window_name}" w "command-prompt -l -I '#W' -p 'Rename window to:' \"rename-window -t #{window_id} '%%'\"" \
    "Session | #{session_name}" s "command-prompt -l -I '#S' -p 'Rename session to:' \"rename-session -t #{session_id} '%%'\"" \
    "" \
    "Cancel" q ""

unbind M-R
bind M-R display-menu -T "Reset name" \
    "Pane    | #{pane_title}" p "run-shell \"~/.config/tmux/scripts/rename_helper.sh reset-pane '#{pane_id}'\"" \
    "Window  | #{window_index}:#{window_name}" w "run-shell \"~/.config/tmux/scripts/rename_helper.sh reset-window '#{window_id}'\"" \
    "Session | #{session_name}" s "run-shell \"~/.config/tmux/scripts/rename_helper.sh reset-session '#{session_id}'\"" \
    "" \
    "Cancel" q ""

unbind ,
bind , "command-prompt -l -I '#W' -p 'Rename window to:' \"rename-window -t #{window_id} '%%'\""

unbind $
bind $ "command-prompt -l -I '#S' -p 'Rename session to:' \"rename-session -t #{session_id} '%%'\""


bind -n M-Left previous-window
bind -n M-Right next-window
bind -n M-S-Left swap-window -t -1 \; select-window -t -1
bind -n M-S-Right swap-window -t +1 \; select-window -t +1


bind -n M-C run-shell "~/.config/tmux/plugins/extrakto/scripts/open.sh \"#{pane_id}\""


# tab mode
unbind t
bind t switch-client -T TAB
bind -n M-t switch-client -T TAB
bind -T TAB h previous-window
bind -T TAB l next-window
bind -T TAB n new-window -a
bind -T TAB x kill-window
bind -T TAB Escape switch-client -T root


# pane mode
unbind s
bind s switch-client -T PANE
bind C-M-s switch-client -T PANE
bind -n M-s switch-client -T PANE
bind -T PANE h select-pane -L \; switch-client -T PANE
bind -T PANE j select-pane -D \; switch-client -T PANE
bind -T PANE k select-pane -U \; switch-client -T PANE
bind -T PANE l select-pane -R \; switch-client -T PANE
bind -T PANE H swap-pane -s "{left-of}" \; switch-client -T PANE
bind -T PANE J swap-pane -s "{down-of}" \; switch-client -T PANE
bind -T PANE K swap-pane -s "{up-of}" \; switch-client -T PANE
bind -T PANE L swap-pane -s "{right-of}" \; switch-client -T PANE
bind -T PANE Escape switch-client -T root

bind -n M-T new-window -a

unbind c
bind c new-window -a
bind -n M-W kill-window

bind -n M-s copy-mode

# column/row "maximize"
unbind -n M-z
# vertical
bind -n M-z if -F '#{@layout_save_v}' \
  {run 'tmux select-layout "#{@layout_save_v}" \; set -uw @layout_save_v'} \
  {run 'tmux set -wF @layout_save_v "#{window_layout}" \; resize-pane -y 100%'}
# horizontal
bind -n M-x if -F '#{@layout_save_h}' \
  {run 'tmux select-layout "#{@layout_save_h}" \; set -uw @layout_save_h'} \
  {run 'tmux set -wF @layout_save_h "#{window_layout}" \; resize-pane -x 100%'}


unbind -n M-MouseDown3Pane
bind   -n M-MouseDown3Pane resize-pane -Z


set -g history-limit 200000
set -g base-index 1           # start windows numbering at 1
setw -g pane-base-index 1     # make pane numbering consistent with windows

setw -g automatic-rename on   # rename window to reflect current program
set -g automatic-rename-format '#{pane_current_command} #{b:pane_current_path}'
set -g renumber-windows on    # renumber windows when a window is closed

set -g set-titles on          # set terminal title

set -g display-panes-time 800 # slightly longer pane indicators display time
set -g display-time 1000      # slightly longer status messages display time

set -g status-interval 2      # redraw status line every 2 seconds
set -g status-right-length 80
set -g status-left-length 60
set -g @gitmux_idle_after 120 # use cached gitmux status after this many idle seconds
set -g @minimal-tmux-right true
set -g @minimal-tmux-status-right '#(~/.config/tmux/scripts/gitmux_status.sh "#{pane_current_path}" "#{session_activity}")'
set -g @minimal-tmux-status-right-extra ""
set -g @minimal-tmux-indicator-str '#(~/.config/tmux/scripts/gitmux_indicator.sh "#{pane_current_path}")'

set -g allow-passthrough on
set -g set-clipboard on

if -F '#{==:#{@gap_bar_template},}' 'set -gFq @gap_bar_template "#{status-format[0]}"'
set -g status 2
set -g status-format[1] '#{T:@gap_bar_template}'
set -g status-format[0] '#[fg=default,bg=default] '

run '~/.config/tmux/plugins/tpm/tpm'
bind -n M-g run-shell 'cmd=""; if command -v ttok-rs >/dev/null 2>&1; then cmd="ttok-rs"; elif command -v ttok >/dev/null 2>&1; then cmd="ttok"; fi; v=$(tmux show -gqv @gitmux_tokens); lv=$(printf "%s" "$v" | tr A-Z a-z); if [ "$lv" = "1" ] || [ "$lv" = "on" ] || [ "$lv" = "true" ]; then tmux set -g @gitmux_tokens 0; tmux display-message "gitmux deltas: tokens OFF"; elif [ -n "$cmd" ]; then tmux set -g @gitmux_tokens 1; tmux display-message "gitmux deltas: tokens ON ($cmd)"; else tmux display-message "gitmux deltas: token CLI missing"; fi; tmux refresh-client -S'
