#!/bin/sh

riverctl border-width 3
riverctl default-layout wideriver

source ~/.config/river/modules/system.sh
source ~/.config/river/modules/keybindings.sh
source ~/.config/river/modules/rules.sh
source ~/.config/river/modules/colors.sh

~/.nix-profile/bin/wideriver \
    --layout                       left               \
    --layout-alt                   monocle            \
    --stack                        dwindle            \
    --count-master                 1                  \
    --ratio-master                 0.50               \
    --count-wide-left              0                  \
    --ratio-wide                   0.35               \
    --no-smart-gaps                                   \
    --inner-gaps                   6                  \
    --outer-gaps                   6                  \
    --border-width                 3                  \
    --border-width-monocle         0                  \
    --border-width-smart-gaps      0                  \
    --border-color-focused         "$RIVER_FOCUSED"   \
    --border-color-focused-monocle "$RIVER_FOCUSED"   \
    --border-color-unfocused       "$RIVER_UNFOCUSED" \
    --log-threshold                info               \
   > "/tmp/wideriver.${XDG_VTNR}.${USER}.log" 2>&1 &

# launch terminal and application launcher
riverctl map normal Super Return spawn '~/.local/bin/ghostty'
