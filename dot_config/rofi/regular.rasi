// vim:ft=rasi

@import "colors.rasi"

configuration {
  modi:                 "drun,run,filebrowser,window";
  dpi:                  90;
  show-icons:           true;
  icon-theme:           "Papirus";
  terminal:             "footclient";
  window-format:        "{w} · {c} · {t}";
  disable-history:      false;
  max-history-size:     50;

  display-drun:         " Apps"; // 󰀻
  display-run:          " Runs";
  display-nerdy:        "󰱨 Nerdy";
  display-emoji:        "󰱨 Emoji";
  display-window:       " Windows";
  display-filebrowser:  " Files";
  display-ssh:          "󰣀 SSH";
  display-keys:         " Keys";

  filebrowser {
    directory: "/home/sumit/";
  }
}

window {
  width: 40%;
  orientation: vertical;
  location: center;
  anchor: center;
  x-offset: 0px;
  y-offset: 0px;
  padding: 5px;
  margin: 0px;
  border: 2px;
  border-radius: 0px; /* Sharp window corners */
  spacing: 0px;
  children: [ mainbox ];
}

mainbox {
  spacing: 3px;
  children: [ inputbar, listview ];
}

inputbar {
  spacing: 3px;
  padding: 0px;
  children: [ prompt, entry ];
}

prompt {
  padding: 3px;
  border-radius: 0px; /* Sharp corners */
}

entry {
  placeholder:  "Search...";
  padding: 3px;
  border-radius: 0px; /* Sharp corners */
}

listview {
  lines: 12;
  spacing: 3px;
  scrollbar: false;
  cycle: false;
  fixed-height: false;
  dynamic: false; // Shrinks window to occupy search result
  margin: 0px;
  padding: 0px;
  border: 0px;
  border-radius: 0px; /* Sharp corners */
}

element {
  border: 0px;
  border-radius: 0px; /* Sharp corners */
  padding: 3px;
}

