# vim: ft=fish

set -U fish_greeting ""
source ~/.config/fish/alias.fish
{{- if eq .chezmoi.os "darwin" }}
set -gx XDG_CONFIG_HOME ~/.config
{{- end }}

# vi + emacs bindings
function fish_user_key_bindings
    fish_default_key_bindings -M insert
    fish_vi_key_bindings --no-erase insert

    # Set cursor shapes for vi mode
    set -g fish_cursor_default block
    set -g fish_cursor_insert line blink
    set -g fish_cursor_replace_one underscore blink
    set -g fish_cursor_visual block
    set -g fish_vi_force_cursor 1

    if set -q TMUX
        functions -q fish_vi_cursor; and fish_vi_cursor xterm
    end

    # backspace to go back a word
    bind -M default \b backward-word
    bind -M default \x7f backward-word
end

fish_add_path -P ~/.lmstudio/bin
{{ if eq .chezmoi.os "linux" }}
fish_add_path $HOME/.nix-profile/bin
fish_add_path $HOME/.local/bin
{{ else if eq .chezmoi.os "darwin" }}
fish_add_path $HOME/.local/bin
fish_add_path /usr/local/bin
fish_add_path $HOME/.nix-profile/bin
fish_add_path /nix/var/nix/profiles/default/bin
set -l uv_python_root $HOME/.local/share/uv/python
if test -d $uv_python_root
    for uv_python_bin in (command find $uv_python_root -maxdepth 2 -type d -name bin 2>/dev/null)
        fish_add_path $uv_python_bin
    end
end
{{ end }}
{{- if (eq .chezmoi.hostname "silverblue") }}
fish_add_path /nix/var/nix/profiles/default/bin/
{{- end }}

# Add flatpak dirs to path
set -gx XDG_DATA_DIRS $XDG_DATA_DIRS ~/.nix-profile/share/applications

set -l xdg_data_home $XDG_DATA_HOME ~/.local/share
set -gx --path XDG_DATA_DIRS $xdg_data_home[1]/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share

for flatpakdir in ~/.local/share/flatpak/exports/bin /var/lib/flatpak/exports/bin
    if test -d $flatpakdir
        contains $flatpakdir $PATH; or set -a PATH $flatpakdir
    end
end

set -Ux GOPATH ~/.go
fish_add_path -P ~/.go/bin
fish_add_path -P ~/.cargo/bin
fish_add_path -P ~/.bun/bin
fish_add_path -P ~/.cache/.bun/bin
fish_add_path -P ~/.local/npm/bin
fish_add_path -P ~/bin

zoxide init fish --cmd cd | source
if type -q fnm
    fnm env --use-on-cd --shell fish | source
end

if status is-interactive
    if not set -q SSH_TTY
        if test -z "$SKIP_TMUX"
            if not set -q TMUX
                if test -t 0; and test -t 1; and test -t 2
                    TERM=xterm-256color tmux
                end
            end
        end
    end

    atuin init fish --disable-up-arrow | source
    bind -M default -e \cr
    bind -M insert  -e \cr
    bind -M insert  \cr _atuin_search

    # ctrl + up
    bind \e\[1\;5A _atuin_search
    bind -M insert \e\[1\;5A _atuin_search

end


set -gx EDITOR nvim
set -gx ZK_NOTEBOOK_DIR ~/notes
set -l _lazygit_colors "$HOME/.config/lazygit/colors.yml"
if test -f $_lazygit_colors
    set -gx LG_CONFIG_FILE $HOME/.config/lazygit/config.yml,$_lazygit_colors
end

# Syntax highlighting
set -g fish_color_autosuggestion 555 brblack
set -g fish_color_cancel -r
set -g fish_color_command --bold
set -g fish_color_comment red
set -g fish_color_cwd green
set -g fish_color_cwd_root red
set -g fish_color_end brmagenta
set -g fish_color_error brred
set -g fish_color_escape bryellow --bold
set -g fish_color_history_current --bold
set -g fish_color_host normal
set -g fish_color_match --background=brblue
set -g fish_color_normal normal
set -g fish_color_operator bryellow
set -g fish_color_param cyan
set -g fish_color_quote yellow
set -g fish_color_redirection brblue
set -g fish_color_search_match bryellow '--background=brblack'
set -g fish_color_selection white --bold '--background=brblack'
set -g fish_color_user brgreen
set -g fish_color_valid_path --underline

# Prompt
if test "$MINIMAL_PROMPT"
    set -gx STARSHIP_CONFIG $HOME/.config/starship/starship-minimal.toml
else
    set -gx STARSHIP_CONFIG $HOME/.config/starship/starship.toml
end
starship init fish | source

export DIRENV_LOG_FORMAT="$(printf "\033[34mdirenv: %%s")"
direnv hook fish | source
