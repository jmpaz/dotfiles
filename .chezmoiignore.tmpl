# Directories to ignore on Mac/Linux

{{- if and (hasKey . "tiling") (not .tiling) }}
.config/niri/
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
.config/rofi/
.config/keyd/
.config/wezterm/
{{- end }}

{{- if eq .chezmoi.os "linux" }}
.config/skhd/
.config/spacebar/
.config/sketchybar/
{{- end }}

{{- if eq .displayServer "X11" }}
.config/waybar/
.config/kanshi/
{{- end }}

{{- if and (eq .displayServer "wayland") (eq .chezmoi.hostname "silverblue") }}
.config/keyd/
.config/zellij/
{{- end }}
